# Public Audius reads work without a key; optional higher metadata limits:
AUDIUS_API_KEY=
# Default: public YouTube Music discovery via the local Python worker (no API key).
YTMUSIC_ENABLED=true
# Optional Python executable override; default is .venv's interpreter if present.
# YTMUSIC_PYTHON=/path/to/python
# Optional fallback if the worker is disabled/missing: official YouTube Data API v3 key.
YOUTUBE_API_KEY=
PORT=5173
# Spotify and Jamendo are intentionally disabled pending developer access / licensing decisions.
